# Copy this file to .env and fill in the keys for the providers you use.
# GVA reads these at startup; any provider without a key is simply skipped.

# Reconnaissance
GEOIP_API_KEY=

# AI providers (set only the ones you want to use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Ollama needs no key (runs locally); start it with `ollama serve`.

# -----------------------------------------------------------------------------
# Model selection (optional). Leave blank to use the economical defaults below.
# Uncomment and change a value to pick a different model for that provider.
# -----------------------------------------------------------------------------

# OpenAI — default: gpt-5.6-luna  (latest GPT-5.6 family, ~$0.20/$1.20 per 1M)
#   alternatives: gpt-5-nano (cheapest, ~$0.05/$0.40), gpt-5.6-terra (stronger),
#                 gpt-5.6-cyber (security-testing variant), gpt-5.6-sol (flagship)
# OPENAI_MODEL=gpt-5.6-luna

# Anthropic — default: claude-haiku-4-5  (cheapest Claude, $1/$5 per 1M)
#   alternatives: claude-sonnet-4-6, claude-opus-4-8
# ANTHROPIC_MODEL=claude-haiku-4-5

# Google Gemini — default: gemini-3.6-flash  (latest Flash, ~$0.75/$3.75 per 1M)
# GEMINI_MODEL=gemini-3.6-flash

# Ollama (local) — default: llama3
# OLLAMA_MODEL=llama3
